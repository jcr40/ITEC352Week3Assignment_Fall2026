#Check password strength
def evaluate_password(password):
    """Look through password and give its rating."""
    has_uppercase ' False
    has_lowercase = False
    has_digit = False
    has_special = False

    for character in password:
        if character.isupper():
            has_uppercase = True
        elif character.islower():
            has_lowercase = True
        elifcharacter.isdigit():
            has_digit = True
        else
            has_special = True

   type_total = 0

    if has_uppercase:
        type_total += 1
    if has_lowercase:
        type_total += 1
    if has_digit:
        type_total += 1
    if has_special:
        type_total += 1

    if len(password) >= 12 and type_total == 4:
